# Copy to .env for local runs. In Cloud Run set these as job env vars.
# All are optional: without DRIVE_FOLDER_ID files are written to OUTPUT_DIR.

# Local output folder (also holds the structure cache in .cache/)
ISTATSYNC_OUTPUT_DIR=data

# Google Drive folder (or shared drive) that receives the files.
# The id is the last part of the folder URL.
# ISTATSYNC_DRIVE_FOLDER_ID=

# Catalogue of datasets to download
# ISTATSYNC_CATALOG=datasets.toml

# Seconds between two requests to ISTAT. Do not go below 12:
# ISTAT allows 5 requests/minute and bans the IP for 1-2 days.
# ISTATSYNC_MIN_REQUEST_INTERVAL=13

# ISTATSYNC_REQUEST_TIMEOUT=300
# ISTATSYNC_BASE_URL=https://esploradati.istat.it/SDMXWS/rest
# ISTATSYNC_TIMEZONE=Europe/Rome
